---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import Production from '../components/Production.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MoreProjects from '../components/MoreProjects.astro';
import Figures from '../components/Figures.astro';
import Background from '../components/Background.astro';
import Contact from '../components/Contact.astro';
import FitCheck from '../components/FitCheck.astro';
import FitBrief from '../components/FitBrief.astro';
import PrintFolds from '../components/PrintFolds.astro';
import { join } from 'node:path';
import ResumeDialog from '../components/ResumeDialog.astro';
import { buildResumeView } from '../components/resume-view.ts';
import DemoDialog from '../components/DemoDialog.astro';
import { loadStatusFile } from '../components/status-file.ts';
import { buildTimeline, loadRoles, loadSite } from '../components/data.ts';
import { loadEvidence } from '../lib/content/load.ts';
import { fill, formatPhone, lowerFirst } from '../components/lib.ts';
import { briefTitle } from '../components/fit-view.ts';
import type { FitCopy } from '../components/fit-copy.ts';
import copy from '../components/copy/home.json';

const data = await loadSite();
const { site, resume, claims } = data;
// Plain-words clauses for jargon (copy/home.json "glosses"), appended to card lines and figure captions.
const withGloss = (text: string, gloss?: string): string => (gloss ? `${text} ${gloss}` : text);
const projects = data.projects.map((p) => ({
  ...p,
  oneLiner: withGloss(p.oneLiner, (copy.glosses.projects as Record<string, string>)[p.id]),
}));
const figures = data.figures.map((f) => ({
  ...f,
  caption: withGloss(f.caption, (copy.glosses.figures as Record<string, string>)[f.id]),
}));
const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);
const timeline = buildTimeline(data, copy.figures.plain);
const status = loadStatusFile();
const downSince = (url?: string): string | undefined =>
  url ? status?.demos.find((d) => d.url === url && !d.up)?.checkedAt : undefined;
const demoList = projects.flatMap((p) => (p.demo ? [{ url: p.demo.url, name: p.name }] : []));

// Fit check: evidence items and role summaries are curated content, built here and handed to the island.
const fitCopy = copy.fit as FitCopy;
const evidence = loadEvidence(join(process.cwd(), 'src', 'content'));
const roleList = await loadRoles();
const roleSummary = (id: string) => {
  const r = roleList.find((x) => x.id === id);
  if (!r) throw new Error(`roles.json has no "${id}".`);
  return r.summary;
};
// Résumé dialog and its no-JavaScript links: the ML Engineer PDF is the default (F-04).
const resumeView = buildResumeView(resume, projects);
const defaultRole = roleList.find((r) => r.id === 'ml') ?? roleList[0];
if (!defaultRole) throw new Error('roles.json is empty.');
const resumeHref = `/resume/${defaultRole.pdfFile}`;
const pdfLinks = roleList.map((r) => ({ label: r.title, href: `/resume/${r.pdfFile}` }));
const briefContact = [
  site.email,
  formatPhone(site.phone),
  site.location,
  lowerFirst(site.availability),
];

// Education lines come from resume.json; each takes its dates from the claim named here.
const educationClaims = ['edu-umd', 'edu-pes'];
const education = resume.education.map((e, i) => ({
  school: e.school.split(',')[0] ?? e.school,
  degree: e.degree,
  claimId: educationClaims[i] ?? '',
}));
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <SiteHeader name={site.name} nav={copy.nav} home />
  <main class="main">
    <Hero
      name={site.name}
      location={site.location}
      availability={site.availability}
      email={site.email}
      resumeHref={resumeHref}
      resumeLabel={copy.resume.open}
      claims={claims}
      copy={copy.hero}
    />
    <Production claims={claims} projects={projects} copy={copy.production} />
    <section class="work" id="work" aria-labelledby="work-heading">
      <p class="meta">{copy.work.label}</p>
      <h2 id="work-heading">{copy.work.heading}</h2>
      <div class="cards">
        {featured.map((p) => (
          <ProjectCard
            project={p}
            demoLabel={copy.work.demoLink}
            downSince={downSince(p.demo?.url)}
            downText={copy.footer.demoDown}
          />
        ))}
      </div>
      <div>
        <MoreProjects title={copy.work.more} projects={more} />
        <Figures
          title={copy.figures.title}
          intro={copy.figures.intro}
          timelineLabel={copy.figures.timelineLabel}
          timeline={timeline}
          figures={figures}
        />
      </div>
    </section>
    <FitCheck
      copy={fitCopy}
      name={site.name}
      evidence={evidence}
      roles={{ ai: roleSummary('ai'), ml: roleSummary('ml'), ds: roleSummary('ds') }}
    />
    <Background
      claims={claims}
      title={copy.background.title}
      education={education}
      publication={copy.background.publication}
    />
    <Contact
      email={site.email}
      phone={site.phone}
      profiles={site.profiles}
      resumeHref={resumeHref}
      resumeLabel={copy.resume.open}
      pdfLinks={pdfLinks}
      pdfListLabel={copy.resume.pdfList}
      copy={copy.contact}
    />
  </main>
  <SiteFooter profiles={site.profiles} copy={copy.footer} demos={demoList} />
  <DemoDialog copy={copy.demo} />
  <ResumeDialog view={resumeView} roles={roleList} initial={defaultRole.id} copy={copy.resume} />
  <FitBrief
    copy={fitCopy.brief}
    title={briefTitle(site.name, '', '', fitCopy.brief)}
    contact={briefContact}
    background={fill(fitCopy.brief.background, claims)}
  />
  <PrintFolds />
</Base>
