---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/demo.css';
import '../styles/fit.css';
import '../styles/print.css';

interface Props {
  title: string;
  description: string;
  /** Adds robots noindex. Used by the 404 page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Placeholder until the Design Lead ships public/favicon.svg (design spec 13.2). Stops the /favicon.ico 404 in the console. -->
    <link rel="icon" href="data:," />
    {noindex && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/newsreader-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
  </body>
</html>
