---
import { Image } from 'astro:assets';
import BarFigure from './BarFigure.astro';
import type { FigureView } from './data.ts';

interface Props {
  figure: FigureView;
}

const { figure } = Astro.props;
---

<figure class="tile" id={`fig-${figure.id}`} data-project={figure.projectId}>
  <div class="tile__head meta">
    <span>{figure.title}</span>
    <time datetime={figure.dateIso}>{figure.date}</time>
  </div>
  {figure.kind === 'image' && figure.image && (
    <div class="well">
      <Image
        src={figure.image}
        alt={figure.alt}
        width={800}
        widths={[400, 800]}
        sizes="(min-width: 48em) 25rem, 90vw"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
        class="well__img"
      />
    </div>
  )}
  {figure.kind === 'bars' && figure.bars && figure.axisMax !== undefined && (
    <BarFigure bars={figure.bars} axisMax={figure.axisMax} axisLabel={figure.axisLabel} />
  )}
  <figcaption class="tile__caption">
    <p>{figure.caption}</p>
    <p class="note tile__note">{figure.note}</p>
  </figcaption>
</figure>
