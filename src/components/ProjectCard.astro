---
import ExternalLink from './ExternalLink.astro';
import type { ProjectView } from './data.ts';
import { dayLabel, embedUrl } from './status.ts';

interface Props {
  project: ProjectView;
  demoLabel: string;
  /** Check date (YYYY-MM-DD) when status.json says the demo is down. The trigger then stays a plain link. */
  downSince?: string | undefined;
  downText: string;
}

const { project, demoLabel, downSince, downText } = Astro.props;
const embed = project.demo && !downSince ? embedUrl(project.demo.url) : undefined;
---

<article class="card">
  <p class="meta">{project.dateRange}</p>
  <h3>{project.name}</h3>
  <p class="card__line">{project.oneLiner}</p>
  <p class="card__result">
    <span class="card__figure">{project.headline}</span>
    {project.context.length > 0 && <span class="card__context">{project.context.join(' · ')}</span>}
  </p>
  <div class="links">
    {project.demo && (
      <a
        class="text-link"
        href={project.demo.url}
        data-demo-url={embed ? project.demo.url : undefined}
        data-demo-embed={embed}
        data-demo-name={embed ? project.name : undefined}
        data-demo-what={embed ? project.demo.what : undefined}
      >
        {demoLabel}
        <span class="sr-only"> for {project.name}</span>
        <span aria-hidden="true"> ↗</span>
      </a>
    )}
    {project.links.map((l) => (
      <ExternalLink class="text-link" href={l.url} label={l.label} context={project.name} />
    ))}
  </div>
  {downSince && (
    <p class="meta">
      {downText} <time datetime={downSince}>{dayLabel(downSince)}</time>
    </p>
  )}
</article>
