---
// The only inline script on the site: JSON-LD (F-12). It is data, not code, so the CSP does not govern it
// (public/_headers; the headers test allows exactly type="application/ld+json"). Kept in its own file so the
// layout and page guards in src/styles/assets.test.ts can stay strict everywhere else.
import { jsonLdText } from './seo.ts';

interface Props {
  data: object;
}
const { data } = Astro.props;
const text = jsonLdText(data);
---

<script type="application/ld+json" set:html={text} />
