---
import { fill, lowerFirst, type ClaimMap } from './lib.ts';

interface Props {
  name: string;
  location: string;
  availability: string;
  email: string;
  /** Link to the default résumé PDF; with JavaScript the dialog script turns it into a button (F-04). */
  resumeHref: string;
  resumeLabel: string;
  claims: ClaimMap;
  copy: {
    role: string;
    lede: string;
    emailSubject: string;
    resultsLabel: string;
    results: { figure: string; caption: string }[];
    credentials: string;
  };
}

const { name, location, availability, email, resumeHref, resumeLabel, claims, copy } = Astro.props;
const eyebrow = `${copy.role} · ${location} · ${lowerFirst(availability)}`;
const mailto = `mailto:${email}?subject=${encodeURIComponent(copy.emailSubject)}`;
---

<section class="hero" aria-label="Introduction">
  <div class="hero__intro">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{name}</h1>
    <p class="lede">{copy.lede}</p>
    <div class="actions">
      <a class="btn" href={resumeHref} data-resume-open>
        {resumeLabel}
      </a>
      <a class="text-link" href={mailto}>
        {email}
      </a>
    </div>
  </div>
  <div role="group" aria-label={copy.resultsLabel}>
    <dl class="results">
      {copy.results.map((r) => (
        <div class="results__cell">
          <dt class="results__figure">{fill(r.figure, claims)}</dt>
          <dd class="results__caption">{fill(r.caption, claims)}</dd>
        </div>
      ))}
    </dl>
  </div>
  <p class="credentials">{fill(copy.credentials, claims)}</p>
</section>
