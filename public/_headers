# Security headers. Policy of record: docs/spec/08-security.md 8.2, rationale in docs/security/headers.md.
# Owned by Security. Applied by Cloudflare Pages and emulated by `npm run preview`.
#
# Phase 7 only (do not add earlier):
#   - Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
#   - Cloudflare Web Analytics origins in script-src and connect-src
#
# No 'unsafe-inline', no 'unsafe-eval', no hashes (R-505). The build must emit no inline
# script or style. The only inline element allowed is <script type="application/ld+json">,
# which is data and is not executed under script-src.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://*.hf.space; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/for
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/for/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/print
  X-Robots-Tag: noindex, nofollow

/print/*
  X-Robots-Tag: noindex, nofollow
