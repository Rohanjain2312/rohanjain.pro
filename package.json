{
  "name": "rohanjain-pro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-claims.ts --require-dist",
    "preview": "node scripts/preview.mjs",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.include=src/lib/**/*.ts --coverage.thresholds.lines=90",
    "test:e2e": "playwright test --pass-with-no-tests",
    "browsers:install": "npx --no-install playwright install chromium",
    "validate:content": "node scripts/validate-content.ts",
    "check:claims": "node scripts/check-claims.ts",
    "docs:lint": "node scripts/lint-docs.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.{css,astro,html}\" --allow-empty-input",
    "gates:test": "node --test .github/lint-fixtures/ci-gates.test.mjs",
    "lint:html": "node .github/scripts/html-validate.mjs",
    "lint:selftest": "node --test .github/lint-fixtures/lint-rules.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "hooks:install": "husky",
    "hooks:test": "node --test .husky/test/hooks.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.5"
  }
}
