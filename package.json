{
  "name": "rohanjain-pro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-pdf.ts && node scripts/check-claims.ts --require-dist",
    "preview": "node scripts/preview.mjs",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run --passWithNoTests && npm run test:property",
    "test:property": "vitest run --config tests/property/vitest.config.ts",
    "test:coverage": "vitest run --coverage --coverage.include=src/lib/**/*.ts --coverage.thresholds.lines=90 && npm run test:property",
    "mutation": "rm -rf .stryker-tmp && stryker run --testRunner command --coverageAnalysis off --force",
    "mutation:other": "rm -rf .stryker-tmp && stryker run stryker.config.other.mjs --testRunner command --coverageAnalysis off --force",
    "test:e2e": "playwright test --pass-with-no-tests",
    "shots": "node tests/visual/shots.mjs",
    "test:frontend": "playwright test --config tests/a11y/playwright.config.ts",
    "browsers:install": "npx --no-install playwright install chromium",
    "browsers:install:webkit": "npx --no-install playwright install webkit",
    "browsers:install:all": "npx --no-install playwright install chromium firefox webkit",
    "lighthouse": "npm run build && node .github/scripts/lighthouse.mjs",
    "test:browsers": "playwright test --config playwright.config.browsers.ts",
    "validate:content": "node scripts/validate-content.ts && npm run claims:verified",
    "for": "node scripts/for.ts",
    "check:claims": "node scripts/check-claims.ts",
    "claims:verified": "node --test tests/fixtures/claims/check-verification-log.test.mjs",
    "docs:lint": "node scripts/lint-docs.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.{css,astro,html}\" --allow-empty-input",
    "gates:test": "node --test .github/lint-fixtures/ci-gates.test.mjs .github/lint-fixtures/pr-process.test.mjs .github/lint-fixtures/status.test.mjs .github/lint-fixtures/lighthouse.test.mjs .github/lint-fixtures/launch-setup.test.mjs .github/lint-fixtures/launch-deploy-setup.test.mjs",
    "lint:html": "node .github/scripts/html-validate.mjs",
    "lint:selftest": "node --test .github/lint-fixtures/lint-rules.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "hooks:install": "husky",
    "hooks:test": "node --test .husky/test/hooks.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "4.2.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "husky": "9.1.7",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
